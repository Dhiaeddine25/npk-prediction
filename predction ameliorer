   "source": [
    "import os\n",
    "import json\n",
    "import random\n",
    "import copy\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import transforms, models\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "\n",
    "# =========================================================\n",
    "# 0. CONFIG\n",
    "# =========================================================\n",
    "SEED = 42\n",
    "IMG_SIZE = 224\n",
    "BATCH_SIZE = 32\n",
    "EPOCHS_STAGE1 = 10\n",
    "EPOCHS_STAGE2 = 15\n",
    "LR_STAGE1 = 1e-3\n",
    "LR_STAGE2 = 1e-4\n",
    "THRESHOLD = 0.5\n",
    "NUM_WORKERS = 2\n",
    "PIN_MEMORY = True\n",
    "\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "TRAIN_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train\"\n",
    "VALID_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid\"\n",
    "TEST_DIR  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test\"\n",
    "\n",
    "TRAIN_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train/_classesTR.csv\"\n",
    "VALID_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid/_classesv.csv\"\n",
    "TEST_CSV  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test/_classes.csv\"\n",
    "\n",
    "SAVE_DIR = \"/kaggle/working/efficientnetb0_best_generalization\"\n",
    "os.makedirs(SAVE_DIR, exist_ok=True)\n",
    "\n",
    "LABELS = ['K0','K1','K2','N0','N1','N2','P0','P1']\n",
    "NUM_CLASSES = len(LABELS)\n",
    "\n",
    "# =========================================================\n",
    "# 1. REPRODUCIBILITE\n",
    "# =========================================================\n",
    "def seed_everything(seed=42):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "\n",
    "seed_everything(SEED)\n",
    "\n",
    "# =========================================================\n",
    "# 2. CHARGEMENT DES CSV\n",
    "# =========================================================\n",
    "train_df = pd.read_csv(TRAIN_CSV)\n",
    "valid_df = pd.read_csv(VALID_CSV)\n",
    "test_df  = pd.read_csv(TEST_CSV)\n",
    "\n",
    "for df in [train_df, valid_df, test_df]:\n",
    "    for col in LABELS:\n",
    "        df[col] = df[col].astype(np.float32)\n",
    "\n",
    "print(\"Train:\", len(train_df))\n",
    "print(\"Valid:\", len(valid_df))\n",
    "print(\"Test :\", len(test_df))\n",
    "\n",
    "# =========================================================\n",
    "# 3. AUGMENTATIONS\n",
    "# =========================================================\n",
    "class AddGaussianNoise(object):\n",
    "    def __init__(self, std=0.015):\n",
    "        self.std = std\n",
    "\n",
    "    def __call__(self, tensor):\n",
    "        noise = torch.randn_like(tensor) * self.std\n",
    "        return torch.clamp(tensor + noise, 0.0, 1.0)\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomVerticalFlip(p=0.5),\n",
    "    transforms.RandomRotation(degrees=15),\n",
    "    transforms.ColorJitter(\n",
    "        brightness=0.2,\n",
    "        contrast=0.2,\n",
    "        saturation=0.2,\n",
    "        hue=0.05\n",
    "    ),\n",
    "    transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1.5)),\n",
    "    transforms.ToTensor(),\n",
    "    AddGaussianNoise(std=0.015),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "valid_test_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "# =========================================================\n",
    "# 4. DATASET\n",
    "# =========================================================\n",
    "class MultiLabelDataset(Dataset):\n",
    "    def __init__(self, df, image_dir, labels, transform=None):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.image_dir = image_dir\n",
    "        self.labels = labels\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        img_path = os.path.join(self.image_dir, row[\"filename\"])\n",
    "\n",
    "        image = Image.open(img_path).convert(\"RGB\")\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "\n",
    "        target = torch.tensor(row[self.labels].values.astype(np.float32), dtype=torch.float32)\n",
    "        return image, target\n",
    "\n",
    "train_dataset = MultiLabelDataset(train_df, TRAIN_DIR, LABELS, transform=train_transform)\n",
    "valid_dataset = MultiLabelDataset(valid_df, VALID_DIR, LABELS, transform=valid_test_transform)\n",
    "test_dataset  = MultiLabelDataset(test_df, TEST_DIR, LABELS, transform=valid_test_transform)\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=True,\n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "valid_loader = DataLoader(\n",
    "    valid_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=False,\n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "test_loader = DataLoader(\n",
    "    test_dataset,\n",
    "    batch_size=BATCH_SIZE,\n",
    "    shuffle=False,\n",
    "    num_workers=NUM_WORKERS,\n",
    "    pin_memory=PIN_MEMORY\n",
    ")\n",
    "\n",
    "# =========================================================\n",
    "# 5. MODELE EfficientNetB0\n",
    "# =========================================================\n",
    "def build_model():\n",
    "    model = models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\n",
    "    in_features = model.classifier[1].in_features\n",
    "    model.classifier[1] = nn.Linear(in_features, NUM_CLASSES)\n",
    "    return model.to(DEVICE)\n",
    "\n",
    "model = build_model()\n",
    "\n",
    "# =========================================================\n",
    "# 6. LOSS\n",
    "# =========================================================\n",
    "label_counts = train_df[LABELS].sum(axis=0).values\n",
    "neg_counts = len(train_df) - label_counts\n",
    "pos_weight = torch.tensor(\n",
    "    (neg_counts / (label_counts + 1e-6)),\n",
    "    dtype=torch.float32\n",
    ").to(DEVICE)\n",
    "\n",
    "criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n",
    "\n",
    "# =========================================================\n",
    "# 7. METRICS\n",
    "# =========================================================\n",
    "def multilabel_hamming_accuracy(y_true, y_pred):\n",
    "    return np.mean(y_true == y_pred)\n",
    "\n",
    "def compute_metrics_from_probs(y_true, y_prob, threshold=0.5):\n",
    "    if np.isscalar(threshold):\n",
    "        y_pred = (y_prob >= threshold).astype(int)\n",
    "    else:\n",
    "        threshold = np.array(threshold).reshape(1, -1)\n",
    "        y_pred = (y_prob >= threshold).astype(int)\n",
    "\n",
    "    hamming_acc = multilabel_hamming_accuracy(y_true, y_pred)\n",
    "    precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "\n",
    "    per_label_acc = {}\n",
    "    for i, lbl in enumerate(LABELS):\n",
    "        per_label_acc[lbl] = float(np.mean(y_true[:, i] == y_pred[:, i]))\n",
    "\n",
    "    return {\n",
    "        \"hamming_acc\": float(hamming_acc),\n",
    "        \"precision_macro\": float(precision),\n",
    "        \"recall_macro\": float(recall),\n",
    "        \"f1_macro\": float(f1),\n",
    "        \"per_label_acc\": per_label_acc,\n",
    "        \"y_pred\": y_pred\n",
    "    }\n",
    "\n",
    "def evaluate(model, loader, threshold=0.5):\n",
    "    model.eval()\n",
    "    all_targets = []\n",
    "    all_probs = []\n",
    "    total_loss = 0.0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, targets in loader:\n",
    "            images = images.to(DEVICE)\n",
    "            targets = targets.to(DEVICE)\n",
    "\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, targets)\n",
    "            probs = torch.sigmoid(logits)\n",
    "\n",
    "            total_loss += loss.item() * images.size(0)\n",
    "            all_targets.append(targets.cpu().numpy())\n",
    "            all_probs.append(probs.cpu().numpy())\n",
    "\n",
    "    y_true = np.concatenate(all_targets, axis=0)\n",
    "    y_prob = np.concatenate(all_probs, axis=0)\n",
    "\n",
    "    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n",
    "    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n",
    "    metrics[\"y_true\"] = y_true\n",
    "    metrics[\"y_prob\"] = y_prob\n",
    "    return metrics\n",
    "\n",
    "# =========================================================\n",
    "# 8. TTA\n",
    "# =========================================================\n",
    "def evaluate_with_tta(model, loader, threshold=0.5):\n",
    "    model.eval()\n",
    "    all_targets = []\n",
    "    all_probs = []\n",
    "    total_loss = 0.0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, targets in loader:\n",
    "            images = images.to(DEVICE)\n",
    "            targets = targets.to(DEVICE)\n",
    "\n",
    "            logits1 = model(images)\n",
    "            probs1 = torch.sigmoid(logits1)\n",
    "\n",
    "            logits2 = model(torch.flip(images, dims=[3]))\n",
    "            probs2 = torch.sigmoid(logits2)\n",
    "\n",
    "            logits3 = model(torch.flip(images, dims=[2]))\n",
    "            probs3 = torch.sigmoid(logits3)\n",
    "\n",
    "            probs = (probs1 + probs2 + probs3) / 3.0\n",
    "\n",
    "            loss = criterion(logits1, targets)\n",
    "            total_loss += loss.item() * images.size(0)\n",
    "\n",
    "            all_targets.append(targets.cpu().numpy())\n",
    "            all_probs.append(probs.cpu().numpy())\n",
    "\n",
    "    y_true = np.concatenate(all_targets, axis=0)\n",
    "    y_prob = np.concatenate(all_probs, axis=0)\n",
    "\n",
    "    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n",
    "    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n",
    "    metrics[\"y_true\"] = y_true\n",
    "    metrics[\"y_prob\"] = y_prob\n",
    "    return metrics\n",
    "\n",
    "# =========================================================\n",
    "# 9. SEUILS OPTIMAUX\n",
    "# =========================================================\n",
    "def find_best_thresholds(y_true, y_prob):\n",
    "    best_thresholds = []\n",
    "\n",
    "    for i in range(y_true.shape[1]):\n",
    "        best_t = 0.5\n",
    "        best_acc = 0.0\n",
    "\n",
    "        for t in np.arange(0.05, 0.96, 0.01):\n",
    "            y_pred_i = (y_prob[:, i] >= t).astype(int)\n",
    "            acc_i = np.mean(y_true[:, i] == y_pred_i)\n",
    "\n",
    "            if acc_i > best_acc:\n",
    "                best_acc = acc_i\n",
    "                best_t = t\n",
    "\n",
    "        best_thresholds.append(float(best_t))\n",
    "\n",
    "    return np.array(best_thresholds)\n",
    "\n",
    "# =========================================================\n",
    "# 10. HELPERS TRAIN\n",
    "# =========================================================\n",
    "def train_one_epoch(model, loader, optimizer):\n",
    "    model.train()\n",
    "    running_loss = 0.0\n",
    "\n",
    "    for images, targets in loader:\n",
    "        images = images.to(DEVICE)\n",
    "        targets = targets.to(DEVICE)\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        logits = model(images)\n",
    "        loss = criterion(logits, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        running_loss += loss.item() * images.size(0)\n",
    "\n",
    "    return running_loss / len(loader.dataset)\n",
    "\n",
    "def set_trainable_layers_stage1(model):\n",
    "    for param in model.parameters():\n",
    "        param.requires_grad = False\n",
    "\n",
    "    for param in model.classifier.parameters():\n",
    "        param.requires_grad = True\n",
    "\n",
    "def set_trainable_layers_stage2(model):\n",
    "    for param in model.parameters():\n",
    "        param.requires_grad = False\n",
    "\n",
    "    for param in model.features[-1].parameters():\n",
    "        param.requires_grad = True\n",
    "\n",
    "    for param in model.classifier.parameters():\n",
    "        param.requires_grad = True\n",
    "\n",
    "def print_metrics(title, metrics):\n",
    "    print(f\"\\n==================== {title} ====================\")\n",
    "    print(f\"HAMMING ACCURACY    : {metrics['hamming_acc']:.4f}\")\n",
    "    print(f\"PRECISION (macro)   : {metrics['precision_macro']:.4f}\")\n",
    "    print(f\"RECALL (macro)      : {metrics['recall_macro']:.4f}\")\n",
    "    print(f\"F1-SCORE (macro)    : {metrics['f1_macro']:.4f}\")\n",
    "    if \"loss\" in metrics:\n",
    "        print(f\"LOSS                : {metrics['loss']:.4f}\")\n",
    "\n",
    "    print(f\"\\nAccuracy par label ({title}):\")\n",
    "    for lbl, acc in metrics[\"per_label_acc\"].items():\n",
    "        print(f\"{lbl}: {acc:.4f}\")\n",
    "\n",
    "# =========================================================\n",
    "# 11. STAGE 1 - TRANSFER LEARNING\n",
    "# =========================================================\n",
    "print(\"\\n================ STAGE 1: TRANSFER LEARNING ================\")\n",
    "set_trainable_layers_stage1(model)\n",
    "\n",
    "optimizer = torch.optim.Adam(\n",
    "    filter(lambda p: p.requires_grad, model.parameters()),\n",
    "    lr=LR_STAGE1\n",
    ")\n",
    "\n",
    "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    optimizer,\n",
    "    mode=\"max\",\n",
    "    factor=0.5,\n",
    "    patience=2\n",
    ")\n",
    "\n",
    "best_val_acc = -1.0\n",
    "best_state = copy.deepcopy(model.state_dict())\n",
    "best_model_path = os.path.join(SAVE_DIR, \"best_model.pth\")\n",
    "history = []\n",
    "\n",
    "for epoch in range(EPOCHS_STAGE1):\n",
    "    train_loss = train_one_epoch(model, train_loader, optimizer)\n",
    "    val_metrics = evaluate(model, valid_loader, threshold=THRESHOLD)\n",
    "\n",
    "    scheduler.step(val_metrics[\"hamming_acc\"])\n",
    "\n",
    "    history.append({\n",
    "        \"stage\": 1,\n",
    "        \"epoch\": epoch + 1,\n",
    "        \"train_loss\": float(train_loss),\n",
    "        \"val_loss\": float(val_metrics[\"loss\"]),\n",
    "        \"val_hamming_acc\": float(val_metrics[\"hamming_acc\"]),\n",
    "        \"val_f1_macro\": float(val_metrics[\"f1_macro\"])\n",
    "    })\n",
    "\n",
    "    print(f\"\\n[Stage 1 | Epoch {epoch+1}/{EPOCHS_STAGE1}]\")\n",
    "    print(f\"Train Loss        : {train_loss:.4f}\")\n",
    "    print(f\"Valid Loss        : {val_metrics['loss']:.4f}\")\n",
    "    print(f\"Valid Hamming Acc : {val_metrics['hamming_acc']:.4f}\")\n",
    "    print(f\"Valid F1 Macro    : {val_metrics['f1_macro']:.4f}\")\n",
    "\n",
    "    if val_metrics[\"hamming_acc\"] > best_val_acc:\n",
    "        best_val_acc = val_metrics[\"hamming_acc\"]\n",
    "        best_state = copy.deepcopy(model.state_dict())\n",
    "        torch.save(best_state, best_model_path)\n",
    "        print(\"✅ Best model saved\")\n",
    "\n",
    "# =========================================================\n",
    "# 12. STAGE 2 - FINE TUNING\n",
    "# =========================================================\n",
    "print(\"\\n================ STAGE 2: FINE TUNING ================\")\n",
    "model.load_state_dict(best_state)\n",
    "set_trainable_layers_stage2(model)\n",
    "\n",
    "optimizer = torch.optim.Adam(\n",
    "    filter(lambda p: p.requires_grad, model.parameters()),\n",
    "    lr=LR_STAGE2\n",
    ")\n",
    "\n",
    "scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "    optimizer,\n",
    "    mode=\"max\",\n",
    "    factor=0.5,\n",
    "    patience=2\n",
    ")\n",
    "\n",
    "for epoch in range(EPOCHS_STAGE2):\n",
    "    train_loss = train_one_epoch(model, train_loader, optimizer)\n",
    "    val_metrics = evaluate(model, valid_loader, threshold=THRESHOLD)\n",
    "\n",
    "    scheduler.step(val_metrics[\"hamming_acc\"])\n",
    "\n",
    "    history.append({\n",
    "        \"stage\": 2,\n",
    "        \"epoch\": epoch + 1,\n",
    "        \"train_loss\": float(train_loss),\n",
    "        \"val_loss\": float(val_metrics[\"loss\"]),\n",
