mport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom torchvision import transforms, models\nfrom sklearn.metrics import precision_score, recall_score, f1_score\n\n# =========================================================\n# 0. CONFIG\n# =========================================================\nSEED = 42\nMODEL_NAME = \"densenet121\"   # \"densenet121\", \"resnet50\", \"efficientnet_b0\"\nIMG_SIZE = 224\nBATCH_SIZE = 32\nNUM_WORKERS = 2\nPIN_MEMORY = True\nTHRESHOLD = 0.5\n\n# 3 phases\nEPOCHS_HEAD = 8\nEPOCHS_FT1 = 10\nEPOCHS_FT2 = 10\n\nLR_HEAD = 1e-3\nLR_FT1 = 2e-4\nLR_FT2 = 5e-5\n\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\nTRAIN_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train\"\nVALID_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid\"\nTEST_DIR  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test\"\n\nTRAIN_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train/_classesTR.csv\"\nVALID_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid/_classesv.csv\"\nTEST_CSV  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test/_classes.csv\"\n\nSAVE_DIR = f\"/kaggle/working/{MODEL_NAME}_true_tl_ft\"\nos.makedirs(SAVE_DIR, exist_ok=True)\n\nLABELS = ['K0','K1','K2','N0','N1','N2','P0','P1']\nNUM_CLASSES = len(LABELS)\n\n# =========================================================\n# 1. SEED\n# =========================================================\ndef seed_everything(seed=42):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n\nseed_everything(SEED)\n\n# =========================================================\n# 2. CSV\n# =========================================================\ntrain_df = pd.read_csv(TRAIN_CSV)\nvalid_df = pd.read_csv(VALID_CSV)\ntest_df  = pd.read_csv(TEST_CSV)\n\nfor df in [train_df, valid_df, test_df]:\n    for col in LABELS:\n        df[col] = df[col].astype(np.float32)\n\nprint(\"MODEL :\", MODEL_NAME)\nprint(\"Train :\", len(train_df))\nprint(\"Valid :\", len(valid_df))\nprint(\"Test  :\", len(test_df))\n\n# =========================================================\n# 3. TRANSFORMS\n# =========================================================\nclass AddGaussianNoise(object):\n    def __init__(self, std=0.015):\n        self.std = std\n\n    def __call__(self, tensor):\n        noise = torch.randn_like(tensor) * self.std\n        return torch.clamp(tensor + noise, 0.0, 1.0)\n\ntrain_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomHorizontalFlip(p=0.5),\n    transforms.RandomVerticalFlip(p=0.5),\n    transforms.RandomRotation(degrees=15),\n    transforms.ColorJitter(\n        brightness=0.2,\n        contrast=0.2,\n        saturation=0.2,\n        hue=0.05\n    ),\n    transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1.5)),\n    transforms.ToTensor(),\n    AddGaussianNoise(std=0.015),\n    transforms.Normalize(\n        mean=[0.485, 0.456, 0.406],\n        std=[0.229, 0.224, 0.225]\n    )\n])\n\nvalid_test_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(\n        mean=[0.485, 0.456, 0.406],\n        std=[0.229, 0.224, 0.225]\n    )\n])\n\n# =========================================================\n# 4. DATASET\n# =========================================================\nclass MultiLabelDataset(Dataset):\n    def __init__(self, df, image_dir, labels, transform=None):\n        self.df = df.reset_index(drop=True)\n        self.image_dir = image_dir\n        self.labels = labels\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        img_path = os.path.join(self.image_dir, row[\"filename\"])\n        image = Image.open(img_path).convert(\"RGB\")\n\n        if self.transform:\n            image = self.transform(image)\n\n        target = torch.tensor(row[self.labels].values.astype(np.float32), dtype=torch.float32)\n        return image, target\n\ntrain_dataset = MultiLabelDataset(train_df, TRAIN_DIR, LABELS, transform=train_transform)\nvalid_dataset = MultiLabelDataset(valid_df, VALID_DIR, LABELS, transform=valid_test_transform)\ntest_dataset  = MultiLabelDataset(test_df, TEST_DIR, LABELS, transform=valid_test_transform)\n\ntrain_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\nvalid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\ntest_loader  = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\n\n# =========================================================\n# 5. BUILD MODEL\n# =========================================================\ndef build_model(model_name, num_classes):\n    if model_name == \"densenet121\":\n        model = models.densenet121(weights=models.DenseNet121_Weights.DEFAULT)\n        in_features = model.classifier.in_features\n        model.classifier = nn.Linear(in_features, num_classes)\n\n    elif model_name == \"resnet50\":\n        model = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)\n        in_features = model.fc.in_features\n        model.fc = nn.Linear(in_features, num_classes)\n\n    elif model_name == \"efficientnet_b0\":\n        model = models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\n        in_features = model.classifier[1].in_features\n        model.classifier[1] = nn.Linear(in_features, num_classes)\n\n    else:\n        raise ValueError(f\"Model non supporte: {model_name}\")\n\n    return model.to(DEVICE)\n\nmodel = build_model(MODEL_NAME, NUM_CLASSES)\n\n# =========================================================\n# 6. LOSS\n# =========================================================\nlabel_counts = train_df[LABELS].sum(axis=0).values\nneg_counts = len(train_df) - label_counts\npos_weight = torch.tensor((neg_counts / (label_counts + 1e-6)), dtype=torch.float32).to(DEVICE)\n\ncriterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n\n# =========================================================\n# 7. METRICS\n# =========================================================\ndef multilabel_hamming_accuracy(y_true, y_pred):\n    return np.mean(y_true == y_pred)\n\ndef compute_metrics_from_probs(y_true, y_prob, threshold=0.5):\n    if np.isscalar(threshold):\n        y_pred = (y_prob >= threshold).astype(int)\n    else:\n        threshold = np.array(threshold).reshape(1, -1)\n        y_pred = (y_prob >= threshold).astype(int)\n\n    hamming_acc = multilabel_hamming_accuracy(y_true, y_pred)\n    precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\n    recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n    f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n\n    per_label_acc = {}\n    for i, lbl in enumerate(LABELS):\n        per_label_acc[lbl] = float(np.mean(y_true[:, i] == y_pred[:, i]))\n\n    return {\n        \"hamming_acc\": float(hamming_acc),\n        \"precision_macro\": float(precision),\n        \"recall_macro\": float(recall),\n        \"f1_macro\": float(f1),\n        \"per_label_acc\": per_label_acc,\n        \"y_pred\": y_pred\n    }\n\ndef evaluate(model, loader, threshold=0.5):\n    model.eval()\n    all_targets = []\n    all_probs = []\n    total_loss = 0.0\n\n    with torch.no_grad():\n        for images, targets in loader:\n            images = images.to(DEVICE)\n            targets = targets.to(DEVICE)\n\n            logits = model(images)\n            loss = criterion(logits, targets)\n            probs = torch.sigmoid(logits)\n\n            total_loss += loss.item() * images.size(0)\n            all_targets.append(targets.cpu().numpy())\n            all_probs.append(probs.cpu().numpy())\n\n    y_true = np.concatenate(all_targets, axis=0)\n    y_prob = np.concatenate(all_probs, axis=0)\n    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n    metrics[\"y_true\"] = y_true\n    metrics[\"y_prob\"] = y_prob\n    return metrics\n\ndef evaluate_with_tta(model, loader, threshold=0.5):\n    model.eval()\n    all_targets = []\n    all_probs = []\n    total_loss = 0.0\n\n    with torch.no_grad():\n        for images, targets in loader:\n            images = images.to(DEVICE)\n            targets = targets.to(DEVICE)\n\n            logits1 = model(images)\n            probs1 = torch.sigmoid(logits1)\n\n            logits2 = model(torch.flip(images, dims=[3]))\n            probs2 = torch.sigmoid(logits2)\n\n            logits3 = model(torch.flip(images, dims=[2]))\n            probs3 = torch.sigmoid(logits3)\n\n            probs = (probs1 + probs2 + probs3) / 3.0\n\n            loss = criterion(logits1, targets)\n            total_loss += loss.item() * images.size(0)\n\n            all_targets.append(targets.cpu().numpy())\n            all_probs.append(probs.cpu().numpy())\n\n    y_true = np.concatenate(all_targets, axis=0)\n    y_prob = np.concatenate(all_probs, axis=0)\n    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n    metrics[\"y_true\"] = y_true\n    metrics[\"y_prob\"] = y_prob\n    return metrics\n\ndef find_best_thresholds(y_true, y_prob):\n    best_thresholds = []\n    for i in range(y_true.shape[1]):\n        best_t = 0.5\n        best_acc = 0.0\n        for t in np.arange(0.05, 0.96, 0.01):\n            y_pred_i = (y_prob[:, i] >= t).astype(int)\n            acc_i = np.mean(y_true[:, i] == y_pred_i)\n            if acc_i > best_acc:\n                best_acc = acc_i\n               