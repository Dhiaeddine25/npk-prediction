   "source": [
    "import os\n",
    "import json\n",
    "import random\n",
    "import copy\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from PIL import Image\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "from torchvision import transforms, models\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "\n",
    "# =========================================================\n",
    "# 0. CONFIG\n",
    "# =========================================================\n",
    "SEED = 42\n",
    "MODEL_NAME = \"densenet121\"   # \"densenet121\", \"resnet50\", \"efficientnet_b0\"\n",
    "IMG_SIZE = 224\n",
    "BATCH_SIZE = 32\n",
    "NUM_WORKERS = 2\n",
    "PIN_MEMORY = True\n",
    "THRESHOLD = 0.5\n",
    "\n",
    "# 3 phases\n",
    "EPOCHS_HEAD = 8\n",
    "EPOCHS_FT1 = 10\n",
    "EPOCHS_FT2 = 10\n",
    "\n",
    "LR_HEAD = 1e-3\n",
    "LR_FT1 = 2e-4\n",
    "LR_FT2 = 5e-5\n",
    "\n",
    "DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "TRAIN_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train\"\n",
    "VALID_DIR = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid\"\n",
    "TEST_DIR  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test\"\n",
    "\n",
    "TRAIN_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/train/_classesTR.csv\"\n",
    "VALID_CSV = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/valid/_classesv.csv\"\n",
    "TEST_CSV  = \"/kaggle/input/datasets/dhiaeddinesaadallah/prdiction-npk/test/_classes.csv\"\n",
    "\n",
    "SAVE_DIR = f\"/kaggle/working/{MODEL_NAME}_true_tl_ft\"\n",
    "os.makedirs(SAVE_DIR, exist_ok=True)\n",
    "\n",
    "LABELS = ['K0','K1','K2','N0','N1','N2','P0','P1']\n",
    "NUM_CLASSES = len(LABELS)\n",
    "\n",
    "# =========================================================\n",
    "# 1. SEED\n",
    "# =========================================================\n",
    "def seed_everything(seed=42):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "\n",
    "seed_everything(SEED)\n",
    "\n",
    "# =========================================================\n",
    "# 2. CSV\n",
    "# =========================================================\n",
    "train_df = pd.read_csv(TRAIN_CSV)\n",
    "valid_df = pd.read_csv(VALID_CSV)\n",
    "test_df  = pd.read_csv(TEST_CSV)\n",
    "\n",
    "for df in [train_df, valid_df, test_df]:\n",
    "    for col in LABELS:\n",
    "        df[col] = df[col].astype(np.float32)\n",
    "\n",
    "print(\"MODEL :\", MODEL_NAME)\n",
    "print(\"Train :\", len(train_df))\n",
    "print(\"Valid :\", len(valid_df))\n",
    "print(\"Test  :\", len(test_df))\n",
    "\n",
    "# =========================================================\n",
    "# 3. TRANSFORMS\n",
    "# =========================================================\n",
    "class AddGaussianNoise(object):\n",
    "    def __init__(self, std=0.015):\n",
    "        self.std = std\n",
    "\n",
    "    def __call__(self, tensor):\n",
    "        noise = torch.randn_like(tensor) * self.std\n",
    "        return torch.clamp(tensor + noise, 0.0, 1.0)\n",
    "\n",
    "train_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.RandomHorizontalFlip(p=0.5),\n",
    "    transforms.RandomVerticalFlip(p=0.5),\n",
    "    transforms.RandomRotation(degrees=15),\n",
    "    transforms.ColorJitter(\n",
    "        brightness=0.2,\n",
    "        contrast=0.2,\n",
    "        saturation=0.2,\n",
    "        hue=0.05\n",
    "    ),\n",
    "    transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1.5)),\n",
    "    transforms.ToTensor(),\n",
    "    AddGaussianNoise(std=0.015),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "valid_test_transform = transforms.Compose([\n",
    "    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "# =========================================================\n",
    "# 4. DATASET\n",
    "# =========================================================\n",
    "class MultiLabelDataset(Dataset):\n",
    "    def __init__(self, df, image_dir, labels, transform=None):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.image_dir = image_dir\n",
    "        self.labels = labels\n",
    "        self.transform = transform\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.df)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        img_path = os.path.join(self.image_dir, row[\"filename\"])\n",
    "        image = Image.open(img_path).convert(\"RGB\")\n",
    "\n",
    "        if self.transform:\n",
    "            image = self.transform(image)\n",
    "\n",
    "        target = torch.tensor(row[self.labels].values.astype(np.float32), dtype=torch.float32)\n",
    "        return image, target\n",
    "\n",
    "train_dataset = MultiLabelDataset(train_df, TRAIN_DIR, LABELS, transform=train_transform)\n",
    "valid_dataset = MultiLabelDataset(valid_df, VALID_DIR, LABELS, transform=valid_test_transform)\n",
    "test_dataset  = MultiLabelDataset(test_df, TEST_DIR, LABELS, transform=valid_test_transform)\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\n",
    "valid_loader = DataLoader(valid_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\n",
    "test_loader  = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=PIN_MEMORY)\n",
    "\n",
    "# =========================================================\n",
    "# 5. BUILD MODEL\n",
    "# =========================================================\n",
    "def build_model(model_name, num_classes):\n",
    "    if model_name == \"densenet121\":\n",
    "        model = models.densenet121(weights=models.DenseNet121_Weights.DEFAULT)\n",
    "        in_features = model.classifier.in_features\n",
    "        model.classifier = nn.Linear(in_features, num_classes)\n",
    "\n",
    "    elif model_name == \"resnet50\":\n",
    "        model = models.resnet50(weights=models.ResNet50_Weights.DEFAULT)\n",
    "        in_features = model.fc.in_features\n",
    "        model.fc = nn.Linear(in_features, num_classes)\n",
    "\n",
    "    elif model_name == \"efficientnet_b0\":\n",
    "        model = models.efficientnet_b0(weights=models.EfficientNet_B0_Weights.DEFAULT)\n",
    "        in_features = model.classifier[1].in_features\n",
    "        model.classifier[1] = nn.Linear(in_features, num_classes)\n",
    "\n",
    "    else:\n",
    "        raise ValueError(f\"Model non supporte: {model_name}\")\n",
    "\n",
    "    return model.to(DEVICE)\n",
    "\n",
    "model = build_model(MODEL_NAME, NUM_CLASSES)\n",
    "\n",
    "# =========================================================\n",
    "# 6. LOSS\n",
    "# =========================================================\n",
    "label_counts = train_df[LABELS].sum(axis=0).values\n",
    "neg_counts = len(train_df) - label_counts\n",
    "pos_weight = torch.tensor((neg_counts / (label_counts + 1e-6)), dtype=torch.float32).to(DEVICE)\n",
    "\n",
    "criterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n",
    "\n",
    "# =========================================================\n",
    "# 7. METRICS\n",
    "# =========================================================\n",
    "def multilabel_hamming_accuracy(y_true, y_pred):\n",
    "    return np.mean(y_true == y_pred)\n",
    "\n",
    "def compute_metrics_from_probs(y_true, y_prob, threshold=0.5):\n",
    "    if np.isscalar(threshold):\n",
    "        y_pred = (y_prob >= threshold).astype(int)\n",
    "    else:\n",
    "        threshold = np.array(threshold).reshape(1, -1)\n",
    "        y_pred = (y_prob >= threshold).astype(int)\n",
    "\n",
    "    hamming_acc = multilabel_hamming_accuracy(y_true, y_pred)\n",
    "    precision = precision_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    recall = recall_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "    f1 = f1_score(y_true, y_pred, average=\"macro\", zero_division=0)\n",
    "\n",
    "    per_label_acc = {}\n",
    "    for i, lbl in enumerate(LABELS):\n",
    "        per_label_acc[lbl] = float(np.mean(y_true[:, i] == y_pred[:, i]))\n",
    "\n",
    "    return {\n",
    "        \"hamming_acc\": float(hamming_acc),\n",
    "        \"precision_macro\": float(precision),\n",
    "        \"recall_macro\": float(recall),\n",
    "        \"f1_macro\": float(f1),\n",
    "        \"per_label_acc\": per_label_acc,\n",
    "        \"y_pred\": y_pred\n",
    "    }\n",
    "\n",
    "def evaluate(model, loader, threshold=0.5):\n",
    "    model.eval()\n",
    "    all_targets = []\n",
    "    all_probs = []\n",
    "    total_loss = 0.0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, targets in loader:\n",
    "            images = images.to(DEVICE)\n",
    "            targets = targets.to(DEVICE)\n",
    "\n",
    "            logits = model(images)\n",
    "            loss = criterion(logits, targets)\n",
    "            probs = torch.sigmoid(logits)\n",
    "\n",
    "            total_loss += loss.item() * images.size(0)\n",
    "            all_targets.append(targets.cpu().numpy())\n",
    "            all_probs.append(probs.cpu().numpy())\n",
    "\n",
    "    y_true = np.concatenate(all_targets, axis=0)\n",
    "    y_prob = np.concatenate(all_probs, axis=0)\n",
    "    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n",
    "    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n",
    "    metrics[\"y_true\"] = y_true\n",
    "    metrics[\"y_prob\"] = y_prob\n",
    "    return metrics\n",
    "\n",
    "def evaluate_with_tta(model, loader, threshold=0.5):\n",
    "    model.eval()\n",
    "    all_targets = []\n",
    "    all_probs = []\n",
    "    total_loss = 0.0\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for images, targets in loader:\n",
    "            images = images.to(DEVICE)\n",
    "            targets = targets.to(DEVICE)\n",
    "\n",
    "            logits1 = model(images)\n",
    "            probs1 = torch.sigmoid(logits1)\n",
    "\n",
    "            logits2 = model(torch.flip(images, dims=[3]))\n",
    "            probs2 = torch.sigmoid(logits2)\n",
    "\n",
    "            logits3 = model(torch.flip(images, dims=[2]))\n",
    "            probs3 = torch.sigmoid(logits3)\n",
    "\n",
    "            probs = (probs1 + probs2 + probs3) / 3.0\n",
    "\n",
    "            loss = criterion(logits1, targets)\n",
    "            total_loss += loss.item() * images.size(0)\n",
    "\n",
    "            all_targets.append(targets.cpu().numpy())\n",
    "            all_probs.append(probs.cpu().numpy())\n",
    "\n",
    "    y_true = np.concatenate(all_targets, axis=0)\n",
    "    y_prob = np.concatenate(all_probs, axis=0)\n",
    "    metrics = compute_metrics_from_probs(y_true, y_prob, threshold=threshold)\n",
    "    metrics[\"loss\"] = float(total_loss / len(loader.dataset))\n",
    "    metrics[\"y_true\"] = y_true\n",
    "    metrics[\"y_prob\"] = y_prob\n",
    "    return metrics\n",
    "\n",
    "def find_best_thresholds(y_true, y_prob):\n",
    "    best_thresholds = []\n",
    "    for i in range(y_true.shape[1]):\n",
    "        best_t = 0.5\n",
    "        best_acc = 0.0\n",
    "        for t in np.arange(0.05, 0.96, 0.01):\n",
    "            y_pred_i = (y_prob[:, i] >= t).astype(int)\n",
    "            acc_i = np.mean(y_true[:, i] == y_pred_i)\n",
    "            if acc_i > best_acc:\n",
    "                best_acc = acc_i\n",
    "                best_t = t\n",
    "        best_thresholds.append(float(best_t))\n",
    "    return np.array(best_thresholds)\n",
    "\n",
    "def print_metrics(title, metrics):\n",
    "    print(f\"\\n==================== {title} ====================\")\n",
    "    print(f\"HAMMING ACCURACY    : {metrics['hamming_acc']:.4f}\")\n",
    "    print(f\"PRECISION (macro)   : {metrics['precision_macro']:.4f}\")\n",
    "    print(f\"RECALL (macro)      : {metrics['recall_macro']:.4f}\")\n",
    "    print(f\"F1-SCORE (macro)    : {metrics['f1_macro']:.4f}\")\n",
    "    print(f\"LOSS                : {metrics['loss']:.4f}\")\n",
    "    print(f\"\\nAccuracy par label ({title}):\")\n",
    "    for lbl, acc in metrics[\"per_label_acc\"].items():\n",
    "        print(f\"{lbl}: {acc:.4f}\")\n",
    "\n",
    "# =========================================================\n",
    "# 8. FREEZE / UNFREEZE - VRAI TL / FT\n",
    "# =========================================================\n",
    "def freeze_all(model):\n",
    "    for p in model.parameters():\n",
    "        p.requires_grad = False\n",
    "\n",
    "def unfreeze_module(module):\n",
    "    for p in module.parameters():\n",
    "        p.requires_grad = True\n",
    "\n",
    "def set_batchnorm_eval(module):\n",
    "    # utile pendant transfer learning pour stabiliser BN\n",
    "    if isinstance(module, nn.BatchNorm2d):\n",
    "        module.eval()\n",
    "\n",
    "def configure_stage(model, model_name, stage):\n",
    "    freeze_all(model)\n",
    "\n",
    "    if model_name == \"densenet121\":\n",
    "        if stage == \"head\":\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "        elif stage == \"ft1\":\n",
    "            unfreeze_module(model.features.denseblock4)\n",
    "            unfreeze_module(model.features.norm5)\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "        elif stage == \"ft2\":\n",
    "            unfreeze_module(model.features.transition3)\n",
    "            unfreeze_module(model.features.denseblock4)\n",
    "            unfreeze_module(model.features.norm5)\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "    elif model_name == \"resnet50\":\n",
    "        if stage == \"head\":\n",
    "            unfreeze_module(model.fc)\n",
    "\n",
    "        elif stage == \"ft1\":\n",
    "            unfreeze_module(model.layer4)\n",
    "            unfreeze_module(model.fc)\n",
    "\n",
    "        elif stage == \"ft2\":\n",
    "            unfreeze_module(model.layer3)\n",
    "            unfreeze_module(model.layer4)\n",
    "            unfreeze_module(model.fc)\n",
    "\n",
    "    elif model_name == \"efficientnet_b0\":\n",
    "        if stage == \"head\":\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "        elif stage == \"ft1\":\n",
    "            unfreeze_module(model.features[-1])\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "        elif stage == \"ft2\":\n",
    "            unfreeze_module(model.features[-2])\n",
    "            unfreeze_module(model.features[-1])\n",
    "            unfreeze_module(model.classifier)\n",
    "\n",
    "def get_optimizer(model, lr):\n",
    "    params = [p for p in model.parameters() if p.requires_grad]\n",
    "    return torch.optim.Adam(params, lr=lr)\n",
    "\n",
    "def count_trainable_params(model):\n",
    "    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)\n",
    "    total = sum(p.numel() for p in model.parameters())\n",
    "    return trainable, total\n",
    "\n",
    "# =========================================================\n",
    "# 9. TRAIN\n",
    "# =========================================================\n",
    "def train_one_epoch(model, loader, optimizer, freeze_bn=False):\n",
    "    model.train()\n",
    "    if freeze_bn:\n",
    "        model.apply(set_batchnorm_eval)\n",
    "\n",
    "    running_loss = 0.0\n",
    "    for images, targets in loader:\n",
    "        images = images.to(DEVICE)\n",
    "        targets = targets.to(DEVICE)\n",
    "\n",
    "        optimizer.zero_grad()\n",
    "        logits = model(images)\n",
    "        loss = criterion(logits, targets)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        running_loss += loss.item() * images.size(0)\n",
    "\n",
    "    return running_loss / len(loader.dataset)\n",
    "\n",
    "def run_stage(model, stage_name, epochs, lr, freeze_bn=False, best_val_acc=-1.0, best_state=None, history=None):\n",
    "    optimizer = get_optimizer(model, lr)\n",
    "    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "        optimizer, mode=\"max\", factor=0.5, patience=2\n",
    "    )\n",
    "\n",
    "    tr_params, total_params = count_trainable_params(model)\n",
    "    print(f\"\\n===== STAGE {stage_name} =====\")\n",
    "    print(f\"Trainable params: {tr_params}/{total_params}\")\n",
    "    print(f\"LR: {lr}\")\n",
    "\n",
    "    for epoch in range(epochs):\n",
    "        train_loss = train_one_epoch(model, train_loader, optimizer, freeze_bn=freeze_bn)\n",
    "        val_metrics = evaluate(model, valid_loader, threshold=THRESHOLD)\n",
    "        scheduler.step(val_metrics[\"hamming_acc\"])\n",
    "\n",
    "        history.append({\n",
    "            \"stage\": stage_name,\n",
    "            \"epoch\": epoch + 1,\n",
    "            \"train_loss\": float(train_loss),\n",
    "            \"val_loss\": float(val_metrics[\"loss\"]),\n",
    "            \"val_hamming_acc\": float(val_metrics[\"hamming_acc\"]),\n",
    "            \"val_f1_macro\": float(val_metrics[\"f1_macro\"])\n",
    "        })\n",
    "\n",
    "        print(f\"\\n[{stage_name} | Epoch {epoch+1}/{epochs}]\")\n",
    "        print(f\"Train Loss        : {train_loss:.4f}\")\n",
    "        print(f\"Valid Loss        : {val_metrics['loss']:.4f}\")\n",
    "        print(f\"Valid Hamming Acc : {val_metrics['hamming_acc']:.4f}\")\n",
    "        print(f\"Valid F1 Macro    : {val_metrics['f1_macro']:.4f}\")\n",
    "\n",
    "        if val_metrics[\"hamming_acc\"] > best_val_acc:\n",
    "            best_val_acc = val_metrics[\"hamming_acc\"]\n",
    "            best_state = copy.deepcopy(model.state_dict())\n",
    "            torch.save(best_state, os.path.join(SAVE_DIR, \"best_model.pth\"))\n",
    "            print(\"✅ Best model saved\")\n",
    "\n",
    "    return best_val_acc, best_state, history\n",
    "\n",
    "# =========================================================\n",
    "# 10. EXECUTION TL + FT\n",
    "# =========================================================\n",
    "best_val_acc = -1.0\n",
    "best_state = copy.deepcopy(model.state_dict())\n",
    "history = []\n",
    "\n",
    "# -------- Phase 1: vrai transfer learning --------\n",
    "configure_stage(model, MODEL_NAME, \"head\")\n",
    "best_val_acc, best_state, history = run_stage(\n",
    "    model,\n",
    "    stage_name=\"HEAD_TRAINING\",\n",
    "    epochs=EPOCHS_HEAD,\n",
    "    lr=LR_HEAD,\n",
    "    freeze_bn=True,\n",
    "    best_val_acc=best_val_acc,\n",
    "    best_state=best_state,\n",
    "    history=history\n",
    ")\n",
    "\n",
    "# -------- Phase 2: fine-tuning 1 --------\n",
    "model.load_state_dict(best_state)\n",
    "configure_stage(model, MODEL_NAME, \"ft1\")\n",
    "best_val_acc, best_state, history = run_stage(\n",
    "    model,\n",
    "    stage_name=\"FINE_TUNING_1\",\n",
    "    epochs=EPOCHS_FT1,\n",
    "    lr=LR_FT1,\n",
    "    freeze_bn=False,\n",
    "    best_val_acc=best_val_acc,\n",
    "    best_state=best_state,\n",
    "    history=history\n",
    ")\n",
    "\n",
    "# -------- Phase 3: fine-tuning 2 --------\n",
    "model.load_state_dict(best_state)\n",
    "configure_stage(model, MODEL_NAME, \"ft2\")\n",
    "best_val_acc, best_state, history = run_stage(\n",
    "    model,\n",
    "    stage_name=\"FINE_TUNING_2\",\n",
    "    epochs=EPOCHS_FT2,\n",
    "    lr=LR_FT2,\n",
    "    freeze_bn=False,\n",
    "    best_val_acc=best_val_acc,\n",
    "    best_state=best_state,\n",
    "    history=history\n",
    ")\n",
    "\n",
    "print(\"\\nBest validation hamming accuracy:\", best_val_acc)\n",
    "\n",
    "# =========================================================\n",
    "# 11. EVAL FINALE\n",
    "# =========================================================\n",
    "model.load_state_dict(torch.load(os.path.join(SAVE_DIR, \"best_model.pth\"), map_location=DEVICE))\n",
    "\n",
    "valid_metrics_05 = evaluate(model, valid_loader, threshold=0.5)\n",
    "test_metrics_05 = evaluate(model, test_loader, threshold=0.5)\n",
    "\n",
    "print_metrics(\"VALID RESULTS threshold=0.5\", valid_metrics_05)\n",
    "print_metrics(\"TEST RESULTS threshold=0.5\", test_metrics_05)\n",
    "\n",
    "best_thresholds = find_best_thresholds(valid_metrics_05[\"y_true\"], valid_metrics_05[\"y_prob\"])\n",
    "thresholds_dict = {LABELS[i]: float(best_thresholds[i]) for i in range(NUM_CLASSES)}\n",
    "\n",
    "print(\"\\nBest thresholds:\")\n",
    "for k, v in thresholds_dict.items():\n",
    "    print(f\"{k}: {v:.2f}\")\n",
    "\n",
    "valid_metrics_best = evaluate(model, valid_loader, threshold=best_thresholds)\n",
    "test_metrics_best = evaluate(model, test_loader, threshold=best_thresholds)\n",
    "\n",
    "print_metrics(\"VALID RESULTS best thresholds\", valid_metrics_best)\n",
    "print_metrics(\"TEST RESULTS best thresholds\", test_metrics_best)\n",
    "\n",
    "test_metrics_tta = evaluate_with_tta(model, test_loader, threshold=best_thresholds)\n",
    "print_metrics(\"TEST RESULTS TTA best thresholds\", test_metrics_tta)\n",
    "\n",
    "# =========================================================\n",
    "# 12. SAVE\n",
    "# =========================================================\n",
    "results = {\n",
    "    \"model_name\": MODEL_NAME,\n",
    "    \"best_val_hamming_acc\": float(best_val_acc),\n",
    "    \"best_thresholds\": thresholds_dict,\n",
    "    \"test_threshold_05\": {\n",
    "        \"hamming_acc\": float(test_metrics_05[\"hamming_acc\"]),\n",
